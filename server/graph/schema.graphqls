# GraphQL Schema for Dragent Server

scalar DateTime
scalar JSON

type User {
  id: ID!
  email: String!
  firstName: String
  lastName: String
  displayName: String
  avatarUrl: String
  createdAt: DateTime!
}

type AuthPayload {
  accessToken: String!
  refreshToken: String!
  expiresIn: Int!
  user: User!
}

input RegisterInput {
  email: String!
  displayName: String
  deviceName: String!
  platform: String!
}

input LoginInput {
  email: String!
  state: String!
}

type Query {
  me: User!
}

type BlockAnalysis {
  id: ID!
  explanation: String!
  suggestedCommand: String
}

input BlockCompletedInput {
  command: String!
  cwd: String!
  exitCode: Int!
  outputText: String!
  modelName: String!
}

# ── Agentic loop types ────────────────────────────────────────────────────────

# A tool call the LLM wants the client to execute locally.
type AgentToolCall {
  id: String!
  name: String!
  # JSON-encoded arguments matching the tool's parameter schema.
  argsJson: String!
}

# One turn response from the agentic loop.
# Either toolCalls is non-empty (client should execute them and call agentStep again)
# or content is set (LLM has produced a final answer).
type AgentStepResult {
  toolCalls: [AgentToolCall!]!
  content: String!
}

input AgentToolCallInput {
  id: String!
  name: String!
  argsJson: String!
}

input AgentMessageInput {
  # "user" | "assistant" | "tool"
  role: String!
  content: String!
  # For role=tool: the tool_call_id being responded to.
  toolCallId: String
  # For role=assistant with tool calls: JSON array of AgentToolCall.
  toolCallsJson: String
}

input AgentToolInput {
  name: String!
  description: String!
  # JSON Schema object for the tool's parameters.
  parametersJson: String!
}

input AgentStepInput {
  modelName: String!
  system: String!
  messages: [AgentMessageInput!]!
  tools: [AgentToolInput!]!
}

type Mutation {
  # Traditional signup fallback (gated by OAuth / magic link flow using google or github)
  register(input: RegisterInput!): AuthPayload!

  # Exchanges active state details for session payloads
  login(input: LoginInput!): AuthPayload!

  # Rotates the current refresh token to retrieve a new access token
  refreshToken(refreshToken: String!): AuthPayload!

  # Terminate session
  logout: Boolean!

  # Self-Healing diagnostic analysis triggered on terminal failures (single-shot)
  reportBlockCompleted(input: BlockCompletedInput!): BlockAnalysis

  # Agentic self-heal: one turn of the multi-round tool-calling loop.
  # Client executes any returned tool_calls locally, then calls again with results
  # appended as role=tool messages. Repeat until content is non-empty.
  agentStep(input: AgentStepInput!): AgentStepResult!
}
