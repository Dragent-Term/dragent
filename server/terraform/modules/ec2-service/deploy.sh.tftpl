#!/bin/bash
# Blue/green deploy for one ec2-service host. Shared source: user_data.sh.tftpl
# bootstraps new hosts with this file, and the websocket SSM associations
# re-deliver it to live hosts, so the two can never drift.
#
# Convention: $${...} (braced) is a Terraform interpolation rendered before this
# file ever reaches a host; bare $VAR is a shell variable. Keep it that way —
# a braced shell variable would be eaten by Terraform rendering.
set -euo pipefail
IMAGE="${image}"
CONTAINER_PORT="${container_port}"
PORT_A="${container_port}"
PORT_B="$((CONTAINER_PORT + 1))"
ACTIVE_FILE=/etc/dragent/active-port
READY_TIMEOUT=90

mkdir -p /etc/dragent /etc/caddy /var/lock

# The systemd timer fires every 60 s while a deploy can take longer (90 s
# readiness + 60 s drain), so skip when another run holds the lock instead of
# letting two runs start/stop the same idle container concurrently.
exec 9>/var/lock/dragent-deploy.lock || exit 1
flock -n 9 || { echo "[deploy] another run is in progress; skipping."; exit 0; }

# Parameter Store changes must reach the running container without requiring an
# EC2 replacement. Build a complete candidate env file and only install it when
# all required parameters are available. This keeps the last known-good config
# if SSM has a transient failure.
ENV_FILE=/etc/dragent/server.env
ENV_NEXT="$(mktemp /etc/dragent/server.env.XXXXXX)"
cleanup() { rm -f "$ENV_NEXT"; }
trap cleanup EXIT

# Decrypting every SecureString each minute cost ~42k KMS requests a day:
# compare versions (no KMS) and re-read only on change.
FINGERPRINT_FILE=/etc/dragent/ssm-fingerprint
SKIP_SSM=0
CONFIG_CHANGED=0
LISTING="$(printf '%s\n' ${secret_keys} | sed "s|^|${secret_prefix}/|" \
  | xargs -n 10 aws ssm get-parameters --region "${region}" --no-with-decryption \
      --query 'Parameters[].[Name,Version]' --output text --names 2>/dev/null | sort)" || LISTING=""
FINGERPRINT=""
if [ -n "$LISTING" ]; then
  FINGERPRINT="$(
    {
      printf '%s\n' "$LISTING"
      cat <<'PLAINFP'
${plain_env}
PLAINFP
    } | sha256sum | cut -d' ' -f1
  )"
fi
if [ -n "$FINGERPRINT" ] && [ -s "$ENV_FILE" ] \
  && [ "$FINGERPRINT" = "$(cat "$FINGERPRINT_FILE" 2>/dev/null || true)" ]; then
  SKIP_SSM=1
fi

if [ "$SKIP_SSM" = 0 ]; then
cat > "$ENV_NEXT" <<'PLAINENV'
${plain_env}
PLAINENV
missing=""
for KEY in ${secret_keys}; do
  if VAL="$(aws ssm get-parameter --region "${region}" --with-decryption \
        --name "${secret_prefix}/$KEY" --query Parameter.Value --output text 2>/dev/null)"; then
    # One line per value: a multi-line value (the APNs .p8 key) keeps its
    # line breaks as \n, which the server reads back.
    VAL="$(printf '%s' "$VAL" | sed ':a;N;$!ba;s/\n/\\n/g')"
    printf '%s=%s\n' "$KEY" "$VAL" >> "$ENV_NEXT"
  else
    missing="$missing $KEY"
  fi
  unset VAL
done
if [ -n "$missing" ]; then
  echo "[deploy] SSM refresh skipped; missing parameters:$missing"
  for KEY in DATABASE_URL JWT_SECRET; do
    case " $missing " in
      *" $KEY "*)
        echo "[deploy] required parameter $KEY is unavailable; keeping current config"
        exit 1
        ;;
    esac
  done
fi
chmod 600 "$ENV_NEXT"

if ! cmp -s "$ENV_NEXT" "$ENV_FILE"; then
  mv "$ENV_NEXT" "$ENV_FILE"
  CONFIG_CHANGED=1
fi
if [ -n "$FINGERPRINT" ] && [ -z "$missing" ]; then
  printf '%s\n' "$FINGERPRINT" > "$FINGERPRINT_FILE"
fi
fi

docker pull "$IMAGE" >/dev/null
NEW="$(docker image inspect --format '{{.Id}}' "$IMAGE")"
ACTIVE="$(cat "$ACTIVE_FILE" 2>/dev/null || true)"
LEGACY_NAME=""
if [ -z "$ACTIVE" ] && docker inspect server >/dev/null 2>&1; then
  # Pre-blue/green host: the API runs as a single `server` container on PORT_A
  # with no active-port marker. Adopt it as the old generation so the
  # replacement starts on the other port instead of colliding with it, then
  # migrate it through the normal switch + drain path below.
  ACTIVE="$PORT_A"
  LEGACY_NAME="server"
fi
if [ "$ACTIVE" = "$PORT_A" ]; then
  IDLE="$PORT_B"
  OLD_PORT="$PORT_A"
  if [ -n "$LEGACY_NAME" ]; then OLD_NAME="$LEGACY_NAME"; else OLD_NAME="server-$PORT_A"; fi
elif [ "$ACTIVE" = "$PORT_B" ]; then
  IDLE="$PORT_A"; OLD_NAME="server-$PORT_B"; OLD_PORT="$PORT_B"
else
  IDLE="$PORT_A"; OLD_NAME=""; OLD_PORT=""
fi
IDLE_NAME="server-$IDLE"
OLD_IMAGE="$(docker inspect --format '{{.Image}}' "$OLD_NAME" 2>/dev/null || echo none)"
if [ "$OLD_IMAGE" != "$NEW" ] || [ "$CONFIG_CHANGED" = 1 ] || [ -z "$ACTIVE" ] || [ -n "$LEGACY_NAME" ]; then
  docker rm -f "$IDLE_NAME" >/dev/null 2>&1 || true
  docker run -d --name "$IDLE_NAME" --restart always \
    -p "127.0.0.1:$IDLE:$CONTAINER_PORT" --env-file "$ENV_FILE" "$IMAGE" >/dev/null
  ready=0
  for ((i=0; i<READY_TIMEOUT; i++)); do
    if curl -fsS "http://127.0.0.1:$IDLE/ready" >/dev/null; then ready=1; break; fi
    # NOTE: no `| grep -q` here: under `set -o pipefail` grep -q quits after
    # the first match, the writer dies with SIGPIPE, and the check misfires.
    if [ "$(docker inspect -f '{{.State.Running}}' "$IDLE_NAME" 2>/dev/null || echo false)" != "true" ]; then break; fi
    sleep 1
  done
  if [ "$ready" != 1 ]; then
    echo "[deploy] $IDLE_NAME failed readiness; retaining $OLD_NAME"
    docker rm -f "$IDLE_NAME" >/dev/null 2>&1 || true
    exit 1
  fi

  # Caddyfile uses a single active-upstream token. Validate and reload the
  # candidate; if either fails, restore the previous upstream and keep it alive.
  CANDIDATE=/etc/caddy/Caddyfile.candidate
  sed "s/__UPSTREAM_PORT__/$IDLE/g" /etc/caddy/Caddyfile.template > "$CANDIDATE"
  cp "$CANDIDATE" /etc/caddy/Caddyfile
  # NOTE: no `| grep -qx` here: under `set -o pipefail` grep -q quits after the
  # first match, docker ps dies with SIGPIPE when more lines follow, and the
  # check misfires (caddy deemed missing, so no reload and no drain ever run).
  # grep -x without -q reads the whole list, so the test is trustworthy.
  if [ -z "$(docker ps --format '{{.Names}}' 2>/dev/null | grep -x caddy || true)" ]; then
    printf '%s\n' "$IDLE" > "$ACTIVE_FILE"
    printf '%s\n' "$IDLE" > /etc/dragent/caddy-active-port
  elif docker exec caddy caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile >/dev/null && docker exec caddy caddy reload --adapter caddyfile --config /etc/caddy/Caddyfile; then
    printf '%s\n' "$IDLE" > "$ACTIVE_FILE"
    printf '%s\n' "$IDLE" > /etc/dragent/caddy-active-port
    if [ -n "$OLD_NAME" ]; then docker stop -t 60 "$OLD_NAME" >/dev/null || true; docker rm "$OLD_NAME" >/dev/null 2>&1 || true; fi
  else
    if [ -n "$OLD_PORT" ]; then
      sed "s/__UPSTREAM_PORT__/$OLD_PORT/g" /etc/caddy/Caddyfile.template > /etc/caddy/Caddyfile
      docker exec caddy caddy reload --adapter caddyfile --config /etc/caddy/Caddyfile || true
    fi
    docker rm -f "$IDLE_NAME" >/dev/null 2>&1 || true
    exit 1
  fi
fi
