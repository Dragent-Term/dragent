# Caddy reverse-proxy config for one ec2-service host. Shared source: rendered
# once per host in Terraform, then installed by user_data on new hosts and by
# the websocket SSM associations on live hosts, so the two can never drift.
#
# __UPSTREAM_PORT__ is NOT a Terraform variable — the deploy script substitutes
# the currently-active localhost port (8080/8081) at switch time.
{
%{ if acme_email != "" }
  email ${acme_email}
%{ endif }
%{ if forward_domain != "" }
  on_demand_tls {
    ask http://127.0.0.1:__UPSTREAM_PORT__/internal/forward-tls-ask
  }
%{ endif }
}

${domain} {
  reverse_proxy 127.0.0.1:__UPSTREAM_PORT__ {
    header_up Host {http.request.host}
  }
}
%{ if forward_domain != "" }
*.${forward_domain} {
  # Hostname-based forwards keep Vite/Next assets and WebSocket paths native.
  # Caddy obtains individual certificates on demand after the gateway confirms
  # that the UUID host belongs to an active forward.
  tls {
    on_demand
  }
  reverse_proxy 127.0.0.1:__UPSTREAM_PORT__ {
    header_up Host {http.request.host}
  }
}
%{ endif }
