{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium",
        "simulator": "true"
      }
    },
    "development-device": {
      "extends": "development",
      "ios": {
        "resourceClass": "m-medium",
        "simulator": false
      }
    },
    "testflight": {
      "developmentClient": false,
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "android-apk": {
      "distribution": "internal",
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      }
    },
    "development-android": {
      "extends": "development",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "ascAppId": "6830027415"
      }
    },
    "development-device": {
      "ios": {
        "ascAppId": "6830027415"
      }
    }
  }
}
