{
  "name": "dragent-mobile",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "mock-server": "tsx scripts/mock-server.ts",
    "test": "tsx --test scripts/*.test.ts modules/dragent-e2ee/tests/*.test.ts src/transport/__tests__/*.test.ts src/pairing/*.test.ts src/appVersion/*.test.ts src/navigation/awayHome.test.ts src/theme/inputColors.test.ts src/machines/*.test.ts src/coordination/goal.test.ts src/notifications/historyModel.test.ts src/diagnostics/connectionLogModel.test.ts",
    "test:e2ee": "tsx --test --test-timeout=180000 src/transport/__tests__/e2ee/*.test.ts",
    "themes:sync": "tsx scripts/sync-desktop-themes.ts",
    "themes:check": "tsx scripts/sync-desktop-themes.ts --check",
    "protocol:sync": "node src/transport/generate-wire-types.mjs",
    "protocol:check": "node src/transport/generate-wire-types.mjs --check",
    "terminal:sync": "node scripts/sync-terminal-wasm.mjs",
    "terminal:check": "node scripts/sync-terminal-wasm.mjs --check",
    "terminal:bench": "tsx scripts/terminal-scroll-bench.ts",
    "e2ee:build": "bash scripts/build-e2ee-rust.sh",
    "e2ee:check": "bash scripts/build-e2ee-rust.sh pins && bash scripts/build-e2ee-rust.sh check-bindings",
    "e2ee:test:ios": "bash modules/dragent-e2ee/ios/Tests/run-simulator-tests.sh vectors && bash modules/dragent-e2ee/ios/Tests/run-simulator-tests.sh bench",
    "e2ee:test:rust": "cargo test --manifest-path modules/dragent-e2ee/rust/Cargo.toml --locked",
    "eas-build-pre-install": "bash scripts/build-e2ee-rust.sh eas",
    "version:announce": "node scripts/announce-version.mjs"
  },
  "dependencies": {
    "@expo/ui": "~58.0.28",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "expo": "~58.0.22",
    "expo-application": "~58.1.2",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.15",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.29",
    "expo-secure-store": "~58.0.2",
    "expo-speech": "~58.0.4",
    "expo-speech-recognition": "^58.0.1",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "expo-widgets": "~58.0.26",
    "lucide-react-native": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "~19.3.0",
    "oxlint": "~1.90.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
